+
+// The desktop copied (android-clipboard writes wl-paste's text to clipboard-to-android): set Android's clipboard.
+void Aquamarine::CAnlandBackend::onClipboardFile() {
+    alignas(inotify_event) char buf[4096];
+    bool                        changed = false;
+    ssize_t                     n;
+    while ((n = read(clipWatch.get(), buf, sizeof buf)) > 0)
+        for (char* p = buf; p < buf + n;) {
+            auto* e = (inotify_event*)p;
+            if (e->len && strcmp(e->name, "clipboard-to-android") == 0)
+                changed = true;
+            p += sizeof(inotify_event) + e->len;
+        }
+    if (!changed || !display || is_fallback(display))
+        return;
+    std::ifstream     f(clipDir + "/clipboard-to-android", std::ios::binary);
+    std::stringstream ss;
+    ss << f.rdbuf();
+    std::string text = ss.str();
+    if (text.empty() || text == lastClip || text.size() >= (16u << 20))
+        return; // ours coming back (Android -> wl-copy -> wl-paste --watch), or nothing
+    lastClip = text;
+    struct OutputEvent ev = {};
+    ev.type           = OUTPUT_TYPE_CLIPBOARD;
+    ev.clipboard.size = text.size();
+    push_output_event_with_length(display, &ev, text.data(), text.size());
+}
