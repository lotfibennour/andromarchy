+namespace Aquamarine {
+    class CAnlandBackend;
+
+    class CAnlandBuffer : public IBuffer {
+      public:
+        CAnlandBuffer(int index, const SDMABUFAttrs& attrs);
+        virtual ~CAnlandBuffer();
+        virtual eBufferCapability caps();
+        virtual eBufferType       type();
+        virtual void              update(const Hyprutils::Math::CRegion& damage);
+        virtual bool              isSynchronous();
+        virtual bool              good();
+        virtual SDMABUFAttrs      dmabuf();
+
+        const int                 index; // slot in the Anland buffer set
+
+      private:
+        SDMABUFAttrs attrs;
+    };
+
+    // Hands out the Anland buffer set, one slot per acquire(); never allocates.
+    class CAnlandAllocator : public IAllocator {
+      public:
+        CAnlandAllocator(Hyprutils::Memory::CWeakPointer<CAnlandBackend> backend_);
+        virtual Hyprutils::Memory::CSharedPointer<IBuffer>  acquire(const SAllocatorBufferParams& params, Hyprutils::Memory::CSharedPointer<CSwapchain> swapchain);
+        virtual Hyprutils::Memory::CSharedPointer<CBackend> getBackend();
+        virtual int                                         drmFD();
+        virtual eAllocatorType                              type();
+
+        size_t                                              nextSlot = 0; // reset by the backend when the buffer set is replaced
+
+      private:
+        Hyprutils::Memory::CWeakPointer<CAnlandBackend> backend;
+    };
+
+    // Android forwards evdev keycodes, BTN_* buttons and touch in buffer pixels.
+    class CAnlandKeyboard : public IKeyboard {
+      public:
+        virtual const std::string& getName();
+    };
+
+    class CAnlandPointer : public IPointer {
+      public:
+        virtual const std::string& getName();
+    };
+
+    class CAnlandTouch : public ITouch {
+      public:
+        virtual const std::string& getName();
+    };
+
+    class CAnlandOutput : public IOutput {
+      public:
+        virtual ~CAnlandOutput();
+        virtual bool                                                      commit();
+        virtual bool                                                      test();
+        virtual Hyprutils::Memory::CSharedPointer<IBackendImplementation> getBackend();
+        virtual void                                                      scheduleFrame(const scheduleFrameReason reason = AQ_SCHEDULE_UNKNOWN);
+        virtual std::vector<SDRMFormat>                                   getRenderFormats();
+        virtual bool                                                      pendingPageFlip();
+        virtual bool                                                      pendingIdleFrame();
+
+        Hyprutils::Memory::CWeakPointer<CAnlandOutput>                    self;
+
+      private:
+        CAnlandOutput(const std::string& name_, Hyprutils::Memory::CWeakPointer<CAnlandBackend> backend_);
+        void                                                     onConsumerReady();
+
+        Hyprutils::Memory::CWeakPointer<CAnlandBackend>          backend;
+        Hyprutils::Memory::CSharedPointer<std::function<void()>> framecb;
+        bool                                                     frameScheduled = false;
+        bool                                                     consumerReady  = true; // false between trigger_refresh and buffer-ready
+        bool                                                     refreshPending = false; // committed while the consumer was busy
+        std::chrono::steady_clock::time_point                    lastRefresh;            // last frame handed to the consumer
+
+        friend class CAnlandBackend;
+    };
+
+    class CAnlandBackend : public IBackendImplementation {
+      public:
+        virtual ~CAnlandBackend();
+        virtual eBackendType                                               type();
+        virtual bool                                                       start();
+        virtual std::vector<Hyprutils::Memory::CSharedPointer<SPollFD>>    pollFDs();
+        virtual int                                                        drmFD();
+        virtual int                                                        drmRenderNodeFD();
+        virtual bool                                                       dispatchEvents();
+        virtual uint32_t                                                   capabilities();
+        virtual bool                                                       setCursor(Hyprutils::Memory::CSharedPointer<IBuffer> buffer, const Hyprutils::Math::Vector2D& hotspot);
+        virtual void                                                       onReady();
+        virtual std::vector<SDRMFormat>                                    getRenderFormats();
+        virtual std::vector<SDRMFormat>                                    getCursorFormats();
+        virtual bool                                                       createOutput(const std::string& name = "");
+        virtual Hyprutils::Memory::CSharedPointer<IAllocator>              preferredAllocator();
+        virtual std::vector<Hyprutils::Memory::CSharedPointer<IAllocator>> getAllocators();
+        virtual Hyprutils::Memory::CWeakPointer<IBackendImplementation>    getPrimary();
+
