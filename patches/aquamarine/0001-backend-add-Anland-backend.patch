+        void                                                    typeText(const char* text, uint32_t len, uint32_t t);
+
+        Hyprutils::Memory::CWeakPointer<CBackend>               backend;
+        display_ctx*                                            display = nullptr;
+        std::string                                             socketPath;
+        bool                                                    hideTransportFDs = false;
+        Hyprutils::OS::CFileDescriptor                          reconnectTimer;
+        SSwapchainOptions                                       lastSwapchainOptions; // to rebuild the swapchain after a reconnect
+        std::vector<Hyprutils::Memory::CSharedPointer<IBuffer>> buffers;
+        Hyprutils::Memory::CSharedPointer<CAnlandAllocator>     allocator;
+        Hyprutils::Memory::CSharedPointer<CAnlandOutput>        output;
+        Hyprutils::Math::Vector2D                               size;
+        Hyprutils::Memory::CSharedPointer<CAnlandKeyboard>      keyboard;
+        Hyprutils::Memory::CSharedPointer<CAnlandPointer>       pointer;
+        Hyprutils::Memory::CSharedPointer<CAnlandTouch>         touch;
+        int                                                     refreshmHz = 60000;
+
+        friend class CBackend;
+        friend class CAnlandOutput;
+        friend class CAnlandAllocator;
+    };
+};
