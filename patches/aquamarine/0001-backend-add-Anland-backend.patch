+using namespace Aquamarine;
+using namespace Hyprutils::Memory;
+using namespace Hyprutils::Math;
+#define SP CSharedPointer
+
+// Anland wire format -> DRM fourcc. Mirrors protocol_format_to_drm() in the KWin/Weston backends.
+static uint32_t anlandFormatToDRM(uint32_t fmt) {
+    return fmt == 1 ? DRM_FORMAT_ABGR8888 : DRM_FORMAT_XRGB8888;
+}
+
+static uint32_t nowMs() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// ---- input devices ----
+
+const std::string& Aquamarine::CAnlandKeyboard::getName() {
+    static const std::string name = "anland-keyboard";
+    return name;
+}
+
+const std::string& Aquamarine::CAnlandPointer::getName() {
+    static const std::string name = "anland-pointer";
+    return name;
+}
+
+const std::string& Aquamarine::CAnlandTouch::getName() {
+    static const std::string name = "anland-touch";
+    return name;
+}
+
+// ---- buffer ----
+
+Aquamarine::CAnlandBuffer::CAnlandBuffer(int index_, const SDMABUFAttrs& attrs_) : index(index_), attrs(attrs_) {
+    size = attrs.size;
+}
+
+Aquamarine::CAnlandBuffer::~CAnlandBuffer() {
+    events.destroy.emit(); // the fd belongs to the display producer, never close it here
+}
+
+eBufferCapability Aquamarine::CAnlandBuffer::caps() {
+    return BUFFER_CAPABILITY_NONE;
+}
+
+eBufferType Aquamarine::CAnlandBuffer::type() {
+    return BUFFER_TYPE_DMABUF;
+}
+
+void Aquamarine::CAnlandBuffer::update(const CRegion& damage) {
+    ;
+}
+
+bool Aquamarine::CAnlandBuffer::isSynchronous() {
+    return false;
+}
+
+bool Aquamarine::CAnlandBuffer::good() {
+    return attrs.success;
+}
+
+SDMABUFAttrs Aquamarine::CAnlandBuffer::dmabuf() {
+    return attrs;
+}
+
+// ---- allocator ----
+
+Aquamarine::CAnlandAllocator::CAnlandAllocator(CWeakPointer<CAnlandBackend> backend_) : backend(backend_) {
+    ;
+}
+
+SP<IBuffer> Aquamarine::CAnlandAllocator::acquire(const SAllocatorBufferParams& params, SP<CSwapchain> swapchain) {
+    if (!backend || backend->buffers.empty())
+        return nullptr;
+
+    // ponytail: the swapchain asks for exactly bufferCount() buffers (see CSwapchain::fullReconfigure), slot by slot.
+    auto buf = backend->buffers.at(nextSlot % backend->buffers.size());
+    nextSlot++;
+    if (params.size != buf->size)
+        backend->backend->log(AQ_LOG_WARNING, std::format("anland: swapchain wants {}, buffers are {}", params.size, buf->size));
+    return buf;
+}
+
+SP<CBackend> Aquamarine::CAnlandAllocator::getBackend() {
+    return backend ? backend->backend.lock() : nullptr;
+}
+
+int Aquamarine::CAnlandAllocator::drmFD() {
+    return -1;
+}
+
+eAllocatorType Aquamarine::CAnlandAllocator::type() {
+    return AQ_ALLOCATOR_TYPE_ANLAND;
+}
+
+// ---- output ----
+
+Aquamarine::CAnlandOutput::CAnlandOutput(const std::string& name_, CWeakPointer<CAnlandBackend> backend_) : backend(backend_) {
+    name        = name_;
+    description = "Anland Android display";
+    make        = "anland";
+    model       = "anland";
+}
+
+Aquamarine::CAnlandOutput::~CAnlandOutput() {
+    events.destroy.emit();
+}
+
+bool Aquamarine::CAnlandOutput::commit() {
+    const auto  snapshot = state->snapshot();
+    const auto& STATE    = snapshot.state();
+
+    events.commit.emit();
+
+    if ((STATE.committed & COutputState::AQ_OUTPUT_STATE_BUFFER) && STATE.buffer) {
+        auto* buf = dynamic_cast<CAnlandBuffer*>(STATE.buffer.get());
+        if (!buf) {
+            backend->backend->log(AQ_LOG_ERROR, "anland: committed buffer is not an Anland buffer");
+            return false;
+        }
+
+        // The consumer may already have moved get_selected_idx on by now; that is expected (KWin reads it once per frame too).
+        // The consumer waits on this fence GPU-side before scanout; -1 means "already done".
+        if (STATE.explicitInFence >= 0)
+            set_render_fence(backend->display, dup(STATE.explicitInFence));
+
+        // Like KWin: only hand a frame over once the consumer released the previous one, otherwise it drops the connection.
+        if (consumerReady) {
+            trigger_refresh(backend->display);
+            lastRefresh   = std::chrono::steady_clock::now();
+            consumerReady = false;
+        } else
+            refreshPending = true;
+    }
+
+    state->consume(snapshot);
+    needsFrame = false;
+    events.present.emit(IOutput::SPresentEvent{.presented = true});
+    return true;
+}
+
+bool Aquamarine::CAnlandOutput::test() {
+    return true;
+}
+
+SP<IBackendImplementation> Aquamarine::CAnlandOutput::getBackend() {
+    return backend.lock();
+}
+
+std::vector<SDRMFormat> Aquamarine::CAnlandOutput::getRenderFormats() {
+    return backend->getRenderFormats();
+}
+
+bool Aquamarine::CAnlandOutput::pendingPageFlip() {
+    return !consumerReady;
+}
+
+bool Aquamarine::CAnlandOutput::pendingIdleFrame() {
+    return frameScheduled;
+}
+
+void Aquamarine::CAnlandOutput::scheduleFrame(const scheduleFrameReason reason) {
+    if (getenv("ANLAND_INPUT_DEBUG"))
+        backend->backend->log(AQ_LOG_DEBUG, std::format("anland: scheduleFrame reason {} ready {} scheduled {}", (uint32_t)reason, consumerReady, frameScheduled));
+    needsFrame = true;
+
+    if (!framecb) {
+        framecb = makeShared<std::function<void()>>([this, weak = self]() {
+            if (!weak)
+                return;
+            frameScheduled = false;
+            events.frame.emit();
+        });
+    }
+
+    // Paced by the consumer: while a frame is in flight, onConsumerReady() fires the frame instead.
+    if (frameScheduled || !consumerReady)
+        return;
+
+    frameScheduled = true;
+    backend->backend->addIdleEvent(framecb);
+}
+
+void Aquamarine::CAnlandOutput::onConsumerReady() {
+    if (refreshPending) {
+        // a frame was committed while the consumer was busy: hand it over now, stay "not ready"
+        refreshPending = false;
+        trigger_refresh(backend->display);
+        lastRefresh = std::chrono::steady_clock::now();
+        return;
+    }
+    consumerReady = true;
+    if (needsFrame && !frameScheduled) {
+        frameScheduled = true;
+        backend->backend->addIdleEvent(framecb);
+    }
+}
+
+// ---- backend ----
+
+Aquamarine::CAnlandBackend::CAnlandBackend(SP<CBackend> backend_) : backend(backend_) {
+    if (const char* sock = getenv("ANLAND_SOCKET"))
+        socketPath = sock;
+    unsetenv("ANLAND_SOCKET"); // see CBackend::create(): children must not become producers
+}
+
+Aquamarine::CAnlandBackend::~CAnlandBackend() {
+    anland_audio_stop();
+    anland_camera_stop();
+    buffers.clear();
+    if (display)
+        disconnect(display);
+}
+
+eBackendType Aquamarine::CAnlandBackend::type() {
+    return AQ_BACKEND_ANLAND;
+}
+
+bool Aquamarine::CAnlandBackend::start() {
+    if (socketPath.empty()) {
+        backend->log(AQ_LOG_ERROR, "anland: ANLAND_SOCKET is not set");
+        return false;
+    }
+    const char* sock = socketPath.c_str();
+
+    if (connect_to_deamon(&display, sock) < 0) {
+        backend->log(AQ_LOG_ERROR, std::format("anland: cannot connect to the display daemon at {}", sock));
+        display = nullptr;
+        return false;
+    }
+
+    uint32_t w = 0, h = 0, fmt = 0, refresh = 0;
+    get_screen_info(display, &w, &h, &fmt, &refresh);
+    if (refresh > 0)
+        refreshmHz = refresh;
+
+    reconnectTimer = Hyprutils::OS::CFileDescriptor{timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC)};
+    set_fallback_callback(display, &CAnlandBackend::onFallback, this);
+
+    // ponytail: the first connection blocks startup until the Android app is in front (30 s): we need the buffer size for the output mode.
+    int tries = 0;
+    while (try_exit_fallback(display) != 0) {
+        if (++tries > 300) {
+            backend->log(AQ_LOG_ERROR, "anland: the Anland app never connected; open it and retry");
+            return false;
+        }
+        usleep(100000);
+    }
+
+    if (!importBuffers())
+        return false;
+
+    allocator = makeShared<CAnlandAllocator>(self);
+    // Sound: a PipeWire sink whose output goes to the Android speaker, and a source fed by its microphone.
+    // The streams live for the whole session; only the socket is swapped on (re)connect.
+    if (anland_audio_start() < 0)
+        backend->log(AQ_LOG_WARNING, "anland: PipeWire audio unavailable (is pipewire running?)");
+    anland_audio_set_fd(get_audio_fd(display));
+    // Cameras: ask for the service; its fds arrive as an INPUT_TYPE_RESOURCE event (when enabled in the app's settings).
+    push_resources_request(display, SERVICE_TYPE_CAMERA, nullptr);
+    armReconnect(500); // doubles as the heartbeat tick while connected
+    backend->log(AQ_LOG_DEBUG, std::format("anland: connected, {} buffers of {}, {} mHz", buffers.size(), size, refreshmHz));
+    return true;
+}
+
+// (Re)builds `buffers` from the consumer's current dmabuf set. The fds stay owned by the transport.
+bool Aquamarine::CAnlandBackend::importBuffers() {
+    buffers.clear();
+
+    const int count = get_buf_count(display);
+    for (int i = 0; i < count; ++i) {
+        buf_info  info;
+        const int fd = get_dmabuf_fd_at(display, i);
+        if (fd < 0 || get_dmabuf_info_at(display, i, &info) < 0) {
+            backend->log(AQ_LOG_ERROR, std::format("anland: no info for buffer {}", i));
+            buffers.clear();
+            return false;
+        }
+
+        SDMABUFAttrs attrs;
+        attrs.success    = true;
+        attrs.size       = {(double)info.width, (double)info.height};
+        attrs.format     = anlandFormatToDRM(info.format);
+        attrs.modifier   = info.modifier;
+        attrs.planes     = 1;
+        attrs.offsets[0] = info.offset;
+        attrs.strides[0] = info.stride;
+        attrs.fds[0]     = fd;
+        buffers.emplace_back(SP<IBuffer>(new CAnlandBuffer(i, attrs)));
+    }
+
+    if (buffers.empty()) {
+        backend->log(AQ_LOG_ERROR, "anland: the consumer gave us no buffers");
+        return false;
+    }
+
+    size = buffers.at(0)->size;
+    return true;
+}
+
+std::vector<SP<SPollFD>> Aquamarine::CAnlandBackend::pollFDs() {
+    if (!display)
+        return {};
+    // The reconnect timer is always polled; the transport fds only exist while a consumer is connected.
+    std::vector<SP<SPollFD>> fds = {makeShared<SPollFD>(reconnectTimer.get(), [this]() { onReconnectTimer(); })};
+    if (!is_fallback(display) && !hideTransportFDs) {
+        fds.emplace_back(makeShared<SPollFD>(get_buffer_ready_fd(display), [this]() { onBufferReady(); }));
+        fds.emplace_back(makeShared<SPollFD>(get_data_fd(display), [this]() { onInputReadable(); }));
+    }
+    return fds;
+}
+
+
+void Aquamarine::CAnlandBackend::onInputReadable() {
+    InputEvent ev;
+    while (!is_fallback(display) && poll_input_event(display, &ev, 0) > 0)
+        processInput(ev);
+}
+
+// Text from the Android soft keyboard (committed words, suggestions) arrives as UTF-8, not keys. Type it as key
+// presses on Omarchy's US layout, with Shift when needed.
+// ponytail: ASCII only; accents and emoji need the Wayland input-method / text-input protocols.
+static bool usLayoutKey(char c, uint32_t& code, bool& shift) {
+    struct SRow {
+        const char* plain;
+        const char* shifted;
+        uint32_t    first;
+    };
+    static const SRow rows[] = {
+        {"1234567890-=", "!@#$%^&*()_+", 2}, {"qwertyuiop[]", "QWERTYUIOP{}", 16},
+        {"asdfghjkl;'`", "ASDFGHJKL:\"~", 30}, {"zxcvbnm,./", "ZXCVBNM<>?", 44},
+        {"\\", "|", 43}, {" ", "", 57}, {"\n", "", 28}, {"\t", "", 15},
+    };
+    for (const auto& r : rows) {
+        if (const char* at = strchr(r.plain, c); at && c) {
+            code  = r.first + (uint32_t)(at - r.plain);
+            shift = false;
+            return true;
+        }
+        if (const char* at = strchr(r.shifted, c); at && c) {
+            code  = r.first + (uint32_t)(at - r.shifted);
+            shift = true;
+            return true;
+        }
+    }
+    return false;
+}
+
+void Aquamarine::CAnlandBackend::typeText(const char* text, uint32_t len, uint32_t t) {
+    constexpr uint32_t KEY_LEFTSHIFT = 42;
+    for (uint32_t i = 0; i < len; i++) {
+        uint32_t code  = 0;
+        bool     shift = false;
+        if (!usLayoutKey(text[i], code, shift))
+            continue;
+        if (shift)
+            keyboard->events.key.emit(IKeyboard::SKeyEvent{.timeMs = t, .key = KEY_LEFTSHIFT, .pressed = true});
+        keyboard->events.key.emit(IKeyboard::SKeyEvent{.timeMs = t, .key = code, .pressed = true});
+        keyboard->events.key.emit(IKeyboard::SKeyEvent{.timeMs = t, .key = code, .pressed = false});
+        if (shift)
+            keyboard->events.key.emit(IKeyboard::SKeyEvent{.timeMs = t, .key = KEY_LEFTSHIFT, .pressed = false});
+    }
+}
+
+void Aquamarine::CAnlandBackend::processInput(const InputEvent& ev) {
+    const uint32_t t = nowMs();
+    if (getenv("ANLAND_INPUT_DEBUG"))
+        fprintf(stderr, "anland: input type %u a=%d b=%d\n", ev.type, ev.key.action, ev.key.keycode);
+    // positions arrive in buffer pixels; aquamarine wants them normalized to the output
+    auto norm = [this](float x, float y) { return Vector2D{x / size.x, y / size.y}; };
+
+    switch (ev.type) {
+        case INPUT_TYPE_KEY:
+            if (keyboard)
+                keyboard->events.key.emit(IKeyboard::SKeyEvent{.timeMs = t, .key = (uint32_t)ev.key.keycode, .pressed = ev.key.action == INPUT_ACTION_DOWN});
+            break;
+        case INPUT_TYPE_POINTER_MOTION:
+            if (pointer) {
+                pointer->events.warp.emit(IPointer::SWarpEvent{.timeMs = t, .absolute = norm(ev.pointer_motion.x, ev.pointer_motion.y), .output = output});
+                pointer->events.frame.emit();
+            }
+            break;
+        case INPUT_TYPE_POINTER_BUTTON:
+            if (pointer) {
+                pointer->events.button.emit(IPointer::SButtonEvent{.timeMs = t, .button = ev.pointer_button.button, .pressed = ev.pointer_button.pressed != 0});
+                pointer->events.frame.emit();
+            }
+            break;
+        case INPUT_TYPE_POINTER_AXIS:
+            if (pointer) {
+                // protocol axis: 0 = vertical, 1 = horizontal (wayland order, same as aquamarine)
+                pointer->events.axis.emit(IPointer::SAxisEvent{.timeMs   = t,
+                                                               .axis     = ev.pointer_axis.axis == 0 ? IPointer::AQ_POINTER_AXIS_VERTICAL : IPointer::AQ_POINTER_AXIS_HORIZONTAL,
+                                                               .source   = IPointer::AQ_POINTER_AXIS_SOURCE_WHEEL,
+                                                               .delta    = ev.pointer_axis.value,
+                                                               .discrete = (double)ev.pointer_axis.discrete});
+                pointer->events.frame.emit();
+            }
+            break;
+        case INPUT_TYPE_TOUCH:
+            if (!touch)
+                break;
+            switch (ev.touch.action) {
+                case INPUT_ACTION_DOWN:
+                    touch->events.down.emit(ITouch::SDownEvent{.timeMs = t, .touchID = ev.touch.pointer_id, .pos = norm(ev.touch.x, ev.touch.y)});
+                    break;
+                case INPUT_ACTION_UP: touch->events.up.emit(ITouch::SUpEvent{.timeMs = t, .touchID = ev.touch.pointer_id}); break;
+                case INPUT_ACTION_MOVE:
+                    touch->events.move.emit(ITouch::SMotionEvent{.timeMs = t, .touchID = ev.touch.pointer_id, .pos = norm(ev.touch.x, ev.touch.y)});
+                    break;
+                default: break;
+            }
+            break;
+        case INPUT_TYPE_TOUCH_FRAME:
+            if (touch)
+                touch->events.frame.emit();
+            break;
+        case INPUT_TYPE_CLIPBOARD:
+        case INPUT_TYPE_TEXT_INPUT: {
+            // The payload must always be read, or the stream desyncs. ponytail: clipboard not wired yet.
+            const uint32_t len = ev.type == INPUT_TYPE_CLIPBOARD ? ev.clipboard.size : ev.text_input.size;
+            if (len > 0 && len < (16u << 20)) {
+                std::vector<char> text(len);
+                poll_input_event_extend_data(display, text.data(), len, 5000);
+                if (ev.type == INPUT_TYPE_TEXT_INPUT && keyboard)
+                    typeText(text.data(), len, t);
+            }
+            break;
+        }
+        case INPUT_TYPE_RESOURCE: {
+            // Always take the fds so the channel stays in sync; cameras become PipeWire Video/Source nodes.
+            int       fds[16], got = 0;
+            const int n = ev.resource.fdnum < 16 ? (int)ev.resource.fdnum : 16;
+            if (n > 0 && poll_input_event_extend_fds(display, fds, n, &got, 5000) == 1) {
+                if (ev.resource.type == SERVICE_TYPE_CAMERA)
+                    anland_camera_set_fds(fds, got);
+                else
+                    for (int i = 0; i < got; ++i)
+                        close(fds[i]);
+            }
+            break;
+        }
+        default: break; // DISPLAY_REFRESH, ACTION: ignored for now
+    }
+}
+
+void Aquamarine::CAnlandBackend::onFallback(void* data) {
+    // Called by the transport when the Android side goes away (app closed / backgrounded).
+    // Its fds are already closed: drop them from the event loop (deferred, we may be inside their handler) and start retrying.
+    auto* self = (CAnlandBackend*)data;
+    anland_audio_set_fd(-1); // before the transport closes the borrowed fd; the streams keep running (silence)
+    anland_camera_stop();    // nodes come back with the service fds on reconnect
+    self->backend->log(AQ_LOG_DEBUG, "anland: consumer lost, waiting for it to come back");
+    fprintf(stderr, "anland: consumer lost\n");
+    if (self->output && self->output->swapchain && self->output->swapchain->currentOptions().length > 0)
+        self->lastSwapchainOptions = self->output->swapchain->currentOptions();
+    // Stop rendering: the dmabufs are gone. Dropping the swapchain releases the compositor's imports of them.
+    if (self->output) {
+        self->output->consumerReady = false;
+        if (self->output->swapchain)
+            self->output->swapchain->reconfigure(SSwapchainOptions{});
+    }
+    self->buffers.clear();
+    self->armReconnect(300);
+    self->backend->addIdleEvent(makeShared<std::function<void()>>([self]() { self->backend->events.pollFDsChanged.emit(); }));
+}
+
+void Aquamarine::CAnlandBackend::armReconnect(int ms) {
+    itimerspec ts = {.it_value = {.tv_sec = ms / 1000, .tv_nsec = (ms % 1000) * 1000000L}};
+    timerfd_settime(reconnectTimer.get(), 0, &ts, nullptr);
+}
+
+void Aquamarine::CAnlandBackend::onReconnectTimer() {
+    uint64_t expirations;
+    read(reconnectTimer.get(), &expirations, sizeof(expirations));
+
+    if (!is_fallback(display)) {
+        // Heartbeat: the consumer runs in lockstep and resets the link if no frame arrives within 5 s
+        // (display_producer.c, trigger_refresh). An idle compositor sends nothing, so ask for a repaint after 1 s.
+        if (output && output->consumerReady && !output->frameScheduled &&
+            std::chrono::steady_clock::now() - output->lastRefresh > std::chrono::seconds(1)) {
+            output->needsFrame = true;
+            output->events.needsFrame.emit();
+        }
+        armReconnect(500);
+        return;
+    }
+
+    if (try_exit_fallback(display) != 0) {
+        static int attempts = 0;
+        if (++attempts % 10 == 1)
+            fprintf(stderr, "anland: reconnect attempt %d failed\n", attempts);
+        armReconnect(300);
+        return;
+    }
+
+    const auto oldSize = size;
+    if (!importBuffers()) {
+        armReconnect(1000);
+        return;
+    }
+
+    // The Android side sizes its buffers to the screen orientation it had when it (re)connected:
+    // after a rotation the output mode follows, and the compositor reconfigures (events.state, like the Wayland backend).
+    if (output && size != oldSize) {
+        fprintf(stderr, "anland: screen is now %.0fx%.0f\n", size.x, size.y);
+        output->modes.clear();
+        output->modes.emplace_back(SP<SOutputMode>(new SOutputMode(size, (unsigned int)refreshmHz, true)));
+        output->events.state.emit(IOutput::SStateEvent{.size = size});
+    }
+
+    anland_audio_set_fd(get_audio_fd(display));
+    push_resources_request(display, SERVICE_TYPE_CAMERA, nullptr);
+    backend->log(AQ_LOG_DEBUG, std::format("anland: consumer back, {} buffers of {}", buffers.size(), size));
+    fprintf(stderr, "anland: consumer back, %zu buffers of %.0fx%.0f\n", buffers.size(), size.x, size.y);
+
+    // New dmabufs: rebuild the swapchain from them (it was cleared when the consumer went away).
+    if (output && output->swapchain) {
+        auto opts   = lastSwapchainOptions;
+        opts.size   = size;
+        allocator->nextSlot = 0;
+        output->swapchain->reconfigure(opts);
+        output->consumerReady = true;
+        output->scheduleFrame(IOutput::AQ_SCHEDULE_NEEDS_FRAME);
+    }
+
+    // The new transport fds often reuse the old numbers, and compositors key their event sources by fd number
+    // (Hyprland's syncPollFDs): drop them first, then add them back, so the closed ones are really re-registered.
+    armReconnect(500); // resume the heartbeat
+    hideTransportFDs = true;
+    backend->events.pollFDsChanged.emit();
+    hideTransportFDs = false;
+    backend->events.pollFDsChanged.emit();
+}
+
+void Aquamarine::CAnlandBackend::onBufferReady() {
+    if (getenv("ANLAND_INPUT_DEBUG"))
+        backend->log(AQ_LOG_DEBUG, "anland: buffer ready");
+    eventfd_t val;
+    eventfd_read(get_buffer_ready_fd(display), &val);
+    if (output)
+        output->onConsumerReady();
+}
+
+int Aquamarine::CAnlandBackend::drmFD() {
+    return -1;
+}
+
+int Aquamarine::CAnlandBackend::drmRenderNodeFD() {
+    return -1;
+}
+
+bool Aquamarine::CAnlandBackend::dispatchEvents() {
+    return true;
+}
+
+uint32_t Aquamarine::CAnlandBackend::capabilities() {
+    return 0;
+}
+
+bool Aquamarine::CAnlandBackend::setCursor(SP<IBuffer> buffer, const Vector2D& hotspot) {
+    return false;
+}
+
+void Aquamarine::CAnlandBackend::onReady() {
+    createOutput();
+
+    keyboard = makeShared<CAnlandKeyboard>();
+    pointer  = makeShared<CAnlandPointer>();
+    touch    = makeShared<CAnlandTouch>();
+    // Announced from the idle loop: the compositor's input manager does not exist yet while start() runs.
+    backend->addIdleEvent(makeShared<std::function<void()>>([this]() {
+        backend->events.newKeyboard.emit(SP<IKeyboard>(keyboard));
+        backend->events.newPointer.emit(SP<IPointer>(pointer));
+        backend->events.newTouch.emit(SP<ITouch>(touch));
+    }));
+}
+
+std::vector<SDRMFormat> Aquamarine::CAnlandBackend::getRenderFormats() {
+    if (buffers.empty())
+        return {};
+    const auto attrs = buffers.at(0)->dmabuf();
+    return {SDRMFormat{.drmFormat = attrs.format, .modifiers = {attrs.modifier}}};
+}
+
+std::vector<SDRMFormat> Aquamarine::CAnlandBackend::getCursorFormats() {
+    return {};
+}
+
+bool Aquamarine::CAnlandBackend::createOutput(const std::string& name) {
+    if (output)
+        return false; // one Android screen
+
+    output = SP<CAnlandOutput>(new CAnlandOutput(name.empty() ? "ANLAND-1" : name, self));
+    output->self = output;
+    output->modes.emplace_back(SP<SOutputMode>(new SOutputMode(size, (unsigned int)refreshmHz, true)));
+    output->swapchain = CSwapchain::create(allocator, self.lock());
+    backend->events.newOutput.emit(SP<IOutput>(output));
+    return true;
+}
+
+SP<IAllocator> Aquamarine::CAnlandBackend::preferredAllocator() {
+    return allocator;
+}
+
+std::vector<SP<IAllocator>> Aquamarine::CAnlandBackend::getAllocators() {
+    return {allocator};
+}
+
+CWeakPointer<IBackendImplementation> Aquamarine::CAnlandBackend::getPrimary() {
+    return {};
+}
+
+int Aquamarine::CAnlandBackend::bufferCount() const {
+    return (int)buffers.size();
+}
+
+int Aquamarine::CAnlandBackend::selectedIndex() const {
+    return display ? get_selected_idx(display) : 0;
+}
+
+SP<IBuffer> Aquamarine::CAnlandBackend::bufferAt(int index) {
+    return buffers.at(index % buffers.size());
+}
