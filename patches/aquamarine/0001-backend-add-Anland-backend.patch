+// Anland backend: renders into dmabufs owned by the Android "Anland" display app.
+// The app allocates the buffers and picks which one we draw into next (get_selected_idx);
+// we import them, render, hand back a fence and trigger_refresh. No DRM device exists.
+
+#include "./Backend.hpp"
+#include "../allocator/Allocator.hpp"
+#include "../allocator/Swapchain.hpp"
+#include "../output/Output.hpp"
