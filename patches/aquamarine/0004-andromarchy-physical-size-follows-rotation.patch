+
+// The physical size (mm, from Android) follows the screen orientation: clients size themselves from it
+// (Squeekboard in portrait drew flattened keys with the landscape width).
+static void orientPhysicalSize(Aquamarine::IOutput* out, const Hyprutils::Math::Vector2D& px) {
+    auto& mm = out->physicalSize;
+    if (mm.x > 0 && mm.y > 0 && (px.x < px.y) != (mm.x < mm.y))
+        mm = {mm.y, mm.x};
+}
 }
 
 using namespace Aquamarine;
