diff --git a/src/Compositor.cpp b/src/Compositor.cpp
index 1d2d8b9..24412de 100644
--- a/src/Compositor.cpp
+++ b/src/Compositor.cpp
@@ -203,7 +203,10 @@ CCompositor::CCompositor(bool onlyConfig) : m_onlyConfigVerification(onlyConfig)
     std::mt19937                    engine(dev());
     std::uniform_int_distribution<> distribution(0, INT32_MAX);
 
-    m_instanceSignature = std::format("{}_{}_{}", GIT_COMMIT_HASH, std::time(nullptr), distribution(engine));
+    // Anland (Android): $XDG_RUNTIME_DIR lives under /data/data/com.termux/..., and the full 40-char commit hash pushes
