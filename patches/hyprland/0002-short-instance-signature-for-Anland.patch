+    const std::string commit = getenv("ANLAND") ? std::string(GIT_COMMIT_HASH).substr(0, 7) : std::string(GIT_COMMIT_HASH);
+    m_instanceSignature      = std::format("{}_{}_{}", commit, std::time(nullptr), distribution(engine));
 
     setenv("HYPRLAND_INSTANCE_SIGNATURE", m_instanceSignature.c_str(), true);
 
