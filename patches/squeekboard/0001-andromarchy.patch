     for (name, keycode) in pairs {
+        // Andromarchy: an uppercase letter is the Shift level of its lowercase one, as on a hardware keyboard:
+        // the compositor matches shortcuts on the unshifted keysym (Super+Shift+F = Shift + f).
+        let upper_letter = name.len() == 1 && name.chars().all(|c| c.is_ascii_uppercase());
+        if upper_letter {
+            write!(
+                buf,
+                "
+key <I{}> {{ type = \"SQ_LETTER\", [ {}, {} ] }};",
+                keycode,
+                name.to_ascii_lowercase(),
+                name,
+            )?;
+            continue;
+        }
         write!(
             buf,
             "
@@ -412,6 +426,12 @@ key <I{}> {{ [ {} ] }};",
         type \"SHIFT+ALT\" {{
             level_name[Level1]= \"Base\";
         }};
+        type \"SQ_LETTER\" {{
+            modifiers= Shift;
+            map[Shift]= Level2;
+            level_name[Level1]= \"Base\";
+            level_name[Level2]= \"Shift\";
+        }};
 
     }};
 
