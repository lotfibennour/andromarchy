+        eglGetProcAddress("eglExportDMABUFImageQueryMESA");
+    xwl_gbm->export_dmabuf_image =
+        (xwl_egl_export_dmabuf_image_mesa_proc)
+        eglGetProcAddress("eglExportDMABUFImageMESA");
+    if (!xwl_gbm->export_dmabuf_image_query ||
+        !xwl_gbm->export_dmabuf_image) {
+        ErrorF("Xwayland glamor: KGSL surfaceless dma-buf export entrypoints unavailable\n");
+        goto error;
+    }
+
+    xwl_gbm->dmabuf_capable = TRUE;
+    xwl_gbm->glamor_gles = !epoxy_is_desktop_gl();
+    xwl_gbm->implicit_sync = TRUE;
+    xwl_gbm->supports_syncobjs = FALSE;
+    xwl_screen->glvnd_vendor = "mesa";
