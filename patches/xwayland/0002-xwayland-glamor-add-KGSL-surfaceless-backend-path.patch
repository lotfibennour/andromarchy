+                               EGL_DEFAULT_DISPLAY);
+    if (xwl_screen->egl_display == EGL_NO_DISPLAY) {
+        ErrorF("Xwayland glamor: surfaceless EGL display setup failed\n");
+        return FALSE;
+    }
