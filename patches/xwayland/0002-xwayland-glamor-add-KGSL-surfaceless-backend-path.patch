+    if (xwl_screen->explicit_sync) {
+        wp_linux_drm_syncobj_manager_v1_destroy(xwl_screen->explicit_sync);
+        xwl_screen->explicit_sync = NULL;
+    }
+
+    egl_vendor = eglQueryString(xwl_screen->egl_display, EGL_VENDOR);
+    ErrorF("Xwayland glamor: using KGSL surfaceless EGL backend (%s)\n",
+           egl_vendor ? egl_vendor : "unknown vendor");
+    return TRUE;
+
+error:
+    xwl_glamor_gbm_reset_egl(xwl_screen);
+    xwl_gbm->backend = XWL_GLAMOR_BACKEND_GBM;
+    return FALSE;
+}
