# /etc/pacman.d/hooks/00-andromarchy-protect-save.hook: before every transaction, record the current version of
# Andromarchy's own builds (including ones rebuilt since), which zz-andromarchy-protect puts back afterwards.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Recording Andromarchy's own builds...
When = PreTransaction
Exec = /usr/local/bin/andromarchy-protect save -q
